@inherits LayoutComponentBase
@inject CurrentUser User
@inject IBuntingApi Api

<MudThemeProvider @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Flag" Class="mr-2" />
        <MudText Typo="Typo.h6"><MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">Bunting</MudLink></MudText>
        <MudSpacer />
        @if (_me is not null)
        {
            @if (_me.IsInstanceAdmin)
            {
                <MudButton Href="/users" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.People" Class="app-bar-users" aria-label="Users">Users</MudButton>
            }
            <MudText Typo="Typo.body2" Class="mx-3 app-bar-user" data-testid="current-user">@_me.Name</MudText>
        }
        <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="() => _dark = !_dark" aria-label="Toggle theme" />
        <form method="post" action="/account/logout">
            <AntiforgeryToken />
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout" Class="app-bar-signout" aria-label="Sign out">Sign out</MudButton>
        </form>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4 px-3 px-sm-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _dark;
    private MeInfo? _me;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _me = await User.GetAsync();
        }
        catch (ApiException)
        {
            // pages report the problem themselves
        }
    }
}
