@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>@L["Sign in · Bunting"]</PageTitle>

<form method="post" action="/account/login" class="auth-card">
    <AntiforgeryToken />
    <h1>@L["Bunting"]</h1>
    <p class="muted">@L["Sign in to manage your flags."]</p>
    @if (Error is "credentials")
    {
        <p class="error" role="alert">@L["Invalid email or password."]</p>
    }
    else if (Error is "server")
    {
        <p class="error" role="alert">@L["The Bunting server cannot be reached."]</p>
    }
    else if (Error is "expired")
    {
        <p class="error" role="alert">@L["Your session expired. Please sign in again."]</p>
    }
    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
    <label>@L["Email"]<input type="email" name="Email" autocomplete="username" required autofocus /></label>
    <label>@L["Password"]<input type="password" name="Password" autocomplete="current-password" required /></label>
    <button type="submit">@L["Sign in"]</button>
    <p class="muted language"><a href="/culture/en?redirect=/login" data-enhance-nav="false">English</a> · <a href="/culture/tr?redirect=/login" data-enhance-nav="false">Türkçe</a></p>
</form>

@code {
    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }
}
