@page "/p/{Project}/keys"

<PageTitle>@L["API keys"] · @Project · Bunting</PageTitle>

<ProjectShell Project="@Project" Section="keys">
    <EnvironmentTabs Context="environment">
        <ApiKeysPanel Project="@Project" Environment="environment" />
    </EnvironmentTabs>
</ProjectShell>

@code {
    [Parameter]
    public string Project { get; set; } = string.Empty;
}
