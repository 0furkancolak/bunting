@page "/"
@inject IBuntingApi Api
@inject CurrentUser User
@inject UiGuard Guard
@inject NavigationManager Navigation

<PageTitle>Projects · Bunting</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Projects</MudText>

@if (_projects is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @if (_me?.IsInstanceAdmin == true)
    {
        <MudPaper Class="pa-3 mb-4" Outlined="true" data-testid="new-project">
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                <MudTextField T="string" Label="Key" @bind-Value="_key" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" HelperText="lowercase letters, digits, dashes" />
                <MudTextField T="string" Label="Name" @bind-Value="_name" Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Create" Disabled="@(string.IsNullOrWhiteSpace(_key) || string.IsNullOrWhiteSpace(_name))">Create project</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_projects.Count == 0)
    {
        <MudAlert Severity="Severity.Info" data-testid="no-projects">
            You are not a member of any project yet. Ask a project owner or an administrator to add you.
        </MudAlert>
    }

    <MudGrid>
        @foreach (var project in _projects)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true" data-testid="project-card">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">@project.Name</MudText>
                        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">@project.Key · @project.Environments.Count environments</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="@($"/p/{project.Key}")" Color="Color.Primary">Open</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<ProjectInfo>? _projects;
    private MeInfo? _me;
    private string _key = string.Empty;
    private string _name = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _me = await Guard.LoadAsync(() => User.GetAsync());
        _projects = await Guard.LoadAsync(() => Api.GetProjectsAsync()) ?? [];
    }

    private async Task Create()
    {
        ProjectInfo? created = null;
        if (await Guard.RunAsync(async () => created = await Api.CreateProjectAsync(_key.Trim(), _name.Trim()), "Project created"))
        {
            Navigation.NavigateTo($"/p/{created!.Key}");
        }
    }
}
