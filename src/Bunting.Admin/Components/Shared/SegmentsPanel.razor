@inject IBuntingApi Api
@inject UiGuard Guard
@inject IDialogService Dialogs

@if (_segments is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudStack Spacing="2">
        @if (Context.CanEdit && _editing is null)
        {
            <div><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="StartNew" data-testid="new-segment">New segment</MudButton></div>
        }

        @if (_editing is not null)
        {
            <MudPaper Outlined="true" Class="pa-4" data-testid="segment-editor">
                <MudStack Spacing="2">
                    <MudTextField T="string" Label="Key" @bind-Value="_editing.Key" Disabled="@(_editing.Existing is not null)" Immediate="true" Variant="Variant.Outlined" data-testid="segment-key" />
                    <MudTextField T="string" Label="Always included (targeting keys)" @bind-Value="_editing.Included" Lines="3" Variant="Variant.Outlined" HelperText="One per line" Disabled="@(!Context.CanEdit)" />
                    <MudTextField T="string" Label="Always excluded (targeting keys)" @bind-Value="_editing.Excluded" Lines="3" Variant="Variant.Outlined" HelperText="Excluded wins over included and conditions" Disabled="@(!Context.CanEdit)" />
                    <MudText Typo="Typo.subtitle2">Members by condition (all must match)</MudText>
                    <ConditionEditor Conditions="_editing.Conditions" CanEdit="Context.CanEdit" />
                    <MudStack Row="true" Spacing="2">
                        @if (Context.CanEdit)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@string.IsNullOrWhiteSpace(_editing.Key)" data-testid="save-segment">Save segment</MudButton>
                        }
                        <MudButton OnClick="() => _editing = null">Close</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }

        <MudTable T="SegmentInfo" Items="_segments" Dense="true" Outlined="true" Elevation="0" data-testid="segment-table">
            <HeaderContent>
                <MudTh>Segment</MudTh>
                <MudTh>Included</MudTh>
                <MudTh>Excluded</MudTh>
                <MudTh>Conditions</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Key</MudTd>
                <MudTd>@context.Included.Count</MudTd>
                <MudTd>@context.Excluded.Count</MudTd>
                <MudTd>@context.Conditions.Count</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" OnClick="() => Edit(context)">@(Context.CanEdit ? "Edit" : "View")</MudButton>
                    @if (Context.CanEdit)
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => Delete(context)">Delete</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="pa-4">No segments in this environment.</MudText></NoRecordsContent>
        </MudTable>
    </MudStack>
}

@code {
    private sealed class SegmentVm
    {
        public string Key { get; set; } = string.Empty;
        public string Included { get; set; } = string.Empty;
        public string Excluded { get; set; } = string.Empty;
        public List<ConditionVm> Conditions { get; set; } = [];
        public SegmentInfo? Existing { get; set; }
    }

    private List<SegmentInfo>? _segments;
    private SegmentVm? _editing;

    [CascadingParameter]
    public ProjectContext Context { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Project { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public EnvironmentInfo Environment { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _segments = await Guard.LoadAsync(() => Api.GetSegmentsAsync(Project, Environment.Key)) ?? [];

    private void StartNew() => _editing = new SegmentVm { Conditions = [new ConditionVm()] };

    private void Edit(SegmentInfo segment) => _editing = new SegmentVm
    {
        Key = segment.Key,
        Included = string.Join('\n', segment.Included),
        Excluded = string.Join('\n', segment.Excluded),
        Conditions = [.. segment.Conditions.Select(ConditionVm.From)],
        Existing = segment,
    };

    private static List<string> Lines(string text) =>
        [.. text.Split(['\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];

    private async Task Save()
    {
        if (_editing is null)
        {
            return;
        }

        var request = new SegmentRequest(
            _editing.Key.Trim(),
            Lines(_editing.Included),
            Lines(_editing.Excluded),
            [.. _editing.Conditions.Where(c => !string.IsNullOrWhiteSpace(c.Attribute) || c.Operator == ConditionOperator.InSegment).Select(c => c.ToCondition())]);
        var existing = _editing.Existing;
        var saved = await Guard.RunAsync(
            () => existing is null
                ? Api.CreateSegmentAsync(Project, Environment.Key, request)
                : Api.UpdateSegmentAsync(Project, Environment.Key, existing.Key, request, existing.Version),
            "Segment saved");
        if (saved)
        {
            _editing = null;
            await Load();
        }
    }

    private async Task Delete(SegmentInfo segment)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete segment?", $"'{segment.Key}' will be removed from {Environment.Name}. Segments that rules still use cannot be deleted.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true && await Guard.RunAsync(() => Api.DeleteSegmentAsync(Project, Environment.Key, segment.Key, segment.Version), "Segment deleted"))
        {
            await Load();
        }
    }
}
