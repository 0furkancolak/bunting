<MudStack Spacing="1" data-testid="variants">
    @for (var i = 0; i < Rows.Count; i++)
    {
        var row = Rows[i];
        var index = i;
        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" data-testid="variant">
            <MudTextField T="string" Label="Key" Value="row.Key" ValueChanged="v => { row.Key = v ?? string.Empty; Changed(); }" Disabled="@(!CanEdit || KeysLocked)"
                          Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width: 14rem" Immediate="true" />
            @if (Type == FlagType.Boolean)
            {
                <MudSwitch T="bool" Label="@(IsTrue(row) ? "true" : "false")" Value="IsTrue(row)"
                           ValueChanged="v => SetBool(row, v)" Disabled="@(!CanEdit)" Color="Color.Primary" />
            }
            else
            {
                <MudTextField T="string" Label="@(Type == FlagType.Object ? "Value (JSON)" : "Value")" Value="row.ValueText" ValueChanged="v => { row.ValueText = v ?? string.Empty; Changed(); }"
                              Disabled="@(!CanEdit)" Margin="Margin.Dense" Variant="Variant.Outlined" Style="flex: 1" Immediate="true" Lines="@(Type == FlagType.Object ? 3 : 1)"
                              Error="@Errors.ContainsKey(index)" ErrorText="@(Errors.GetValueOrDefault(index))" />
            }
            @if (CanEdit && !KeysLocked && Rows.Count > 1)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Remove variant" OnClick="() => Remove(index)" />
            }
        </MudStack>
    }
    @if (CanEdit && !KeysLocked)
    {
        <div><MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="Add">Add variant</MudButton></div>
    }
</MudStack>

@code {
    [Parameter, EditorRequired]
    public List<VariantVm> Rows { get; set; } = [];

    [Parameter, EditorRequired]
    public FlagType Type { get; set; }

    [Parameter]
    public bool CanEdit { get; set; } = true;

    /// <summary>Existing flags keep their variant keys: configurations in every environment refer to them.</summary>
    [Parameter]
    public bool KeysLocked { get; set; }

    [Parameter]
    public IReadOnlyDictionary<int, string> Errors { get; set; } = new Dictionary<int, string>();

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private void Changed() => OnChanged.InvokeAsync();

    private static bool IsTrue(VariantVm row) => row.ValueText.Equals("true", StringComparison.OrdinalIgnoreCase);

    private void SetBool(VariantVm row, bool value)
    {
        row.ValueText = value ? "true" : "false";
        Changed();
    }

    private void Add()
    {
        Rows.Add(new VariantVm { Key = $"variant-{Rows.Count + 1}", ValueText = Type == FlagType.Boolean ? "false" : string.Empty });
        Changed();
    }

    private void Remove(int index)
    {
        Rows.RemoveAt(index);
        Changed();
    }
}
