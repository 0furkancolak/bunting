@inject IBuntingApi Api
@inject UiGuard Guard

@if (_flag is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@($"/p/{Project}")" aria-label="Back to flags" />
        <MudText Typo="Typo.h5" data-testid="flag-title">@_flag.Key</MudText>
        <MudChip T="string" Size="Size.Small">@_flag.Type</MudChip>
        @if (_flag.Archived) { <MudChip T="string" Size="Size.Small" Color="Color.Warning">archived</MudChip> }
    </MudStack>

    <MudPaper Outlined="true" Class="pa-4 mb-4" data-testid="flag-form">
        <MudStack Spacing="2">
            <MudTextField T="string" Label="Name" @bind-Value="_name" Immediate="true" Disabled="@(!Context.CanEdit)" Variant="Variant.Outlined" />
            <MudTextField T="string" Label="Description" @bind-Value="_description" Disabled="@(!Context.CanEdit)" Variant="Variant.Outlined" Lines="2" />
            <MudTextField T="string" Label="Tags" @bind-Value="_tags" Disabled="@(!Context.CanEdit)" Variant="Variant.Outlined" HelperText="Comma separated" />
            <MudText Typo="Typo.subtitle2">Variants</MudText>
            <VariantEditor Rows="_rows" Type="_flag.Type" CanEdit="Context.CanEdit" KeysLocked="true" Errors="_errors" />
            <MudStack Row="true" Spacing="4">
                <MudCheckBox T="bool" @bind-Value="_clientSide" Label="Available to client-side SDKs" Disabled="@(!Context.CanEdit)" />
                <MudCheckBox T="bool" @bind-Value="_archived" Label="Archived" Disabled="@(!Context.CanEdit)" />
            </MudStack>
            @if (Context.CanEdit)
            {
                <div><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveFlag" data-testid="save-flag">Save flag</MudButton></div>
            }
            else
            {
                <MudText Style="color: var(--mud-palette-text-secondary)" data-testid="read-only">You have read-only access to this project.</MudText>
            }
        </MudStack>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mb-1">Environments</MudText>
    <EnvironmentTabs Context="environment">
        <FlagEnvironmentEditor Project="@Project" Environment="environment" Flag="_flag" />
    </EnvironmentTabs>
}

@code {
    private FlagInfo? _flag;
    private string _name = string.Empty;
    private string? _description;
    private string? _tags;
    private bool _clientSide;
    private bool _archived;
    private List<VariantVm> _rows = [];
    private Dictionary<int, string> _errors = [];

    [CascadingParameter]
    public ProjectContext Context { get; set; } = default!;

    [Parameter]
    public string Project { get; set; } = string.Empty;

    [Parameter]
    public string Flag { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _flag = await Guard.LoadAsync(() => Api.GetFlagAsync(Project, Flag));
        if (_flag is null)
        {
            return;
        }

        _name = _flag.Name;
        _description = _flag.Description;
        _tags = string.Join(", ", _flag.Tags);
        _clientSide = _flag.ClientSideAvailable;
        _archived = _flag.Archived;
        _rows = [.. _flag.Variants.Select(v => VariantVm.From(v.Key, v.Value, _flag.Type))];
    }

    private async Task SaveFlag()
    {
        if (_flag is null || !VariantForm.TryBuild(_rows, _flag.Type, out var variants, out _errors))
        {
            return;
        }

        var tags = (_tags ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        var request = new UpdateFlagRequest(_name.Trim(), _description, variants, tags, _clientSide, _archived);
        FlagInfo? updated = null;
        if (await Guard.RunAsync(async () => updated = await Api.UpdateFlagAsync(Project, Flag, request, _flag.Version), "Flag saved"))
        {
            _flag = updated;
            await Load();
        }
    }
}
